<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:gravity="center_vertical" android:orientation="horizontal">
    <CheckBox android:id="@+id/taskCheck" android:layout_width="0dp"
        android:layout_weight="1" android:minHeight="48dp" android:layout_height="wrap_content" />
    <ImageButton android:id="@+id/deleteTask" android:layout_width="48dp"
        android:layout_height="48dp" android:src="@android:drawable/ic_menu_delete"
        android:contentDescription="Delete task" android:background="?attr/selectableItemBackground" />
</LinearLayout>