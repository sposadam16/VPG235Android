<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cityName_id"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HomeActivity">

    <EditText
        android:id="@+id/loginInput_id"
        android:layout_width="280dp"
        android:layout_height="56dp"
        android:layout_marginStart="80dp"
        android:layout_marginTop="156dp"
        android:layout_marginEnd="80dp"
        android:autofillHints="password"
        android:hint="Login"
        android:inputType="textEmailAddress"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.482"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />

    <EditText
        android:id="@+id/passwordInput_id"
        android:layout_width="280dp"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="65dp"
        android:autofillHints="password"
        android:hint="Password"
        android:inputType="textPassword"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/loginInput_id"
        app:layout_constraintTop_toBottomOf="@+id/loginInput_id" />

    <Button
        android:id="@+id/loginButton_id"
        android:layout_width="280dp"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="66dp"
        android:backgroundTint="#6750A4"
        android:text="Login"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/passwordInput_id"
        app:layout_constraintTop_toBottomOf="@+id/passwordInput_id" />

    <TextView
        android:id="@+id/forgotPassword_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="Forgot Password?"
        android:textColor="#777777"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="@+id/loginButton_id"
        app:layout_constraintStart_toStartOf="@+id/loginButton_id"
        app:layout_constraintTop_toBottomOf="@+id/loginButton_id" />

    <TextView
        android:id="@+id/noAccount_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="100dp"
        android:layout_marginTop="50dp"
        android:text="No account?"
        android:textSize="14sp"
        app:layout_constraintEnd_toStartOf="@+id/signUp_id"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/forgotPassword_id" />

    <TextView
        android:id="@+id/signUp_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:layout_marginEnd="100dp"
        android:text="Sign up"
        android:textColor="#6750A4"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/forgotPassword_id" />

    <TextView
        android:id="@+id/socialNetworks_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="Sing up with social networks"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="@+id/loginButton_id"
        app:layout_constraintStart_toStartOf="@+id/loginButton_id"
        app:layout_constraintTop_toBottomOf="@+id/orText_id" />

    <View
        android:id="@+id/leftLine_id"
        android:layout_width="100dp"
        android:layout_height="1dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="176dp"
        android:layout_marginEnd="20dp"
        android:background="#BBBBBB"
        app:layout_constraintEnd_toStartOf="@+id/orText_id"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/loginButton_id" />

    <View
        android:id="@+id/rightLine_id"
        android:layout_width="100dp"
        android:layout_height="1dp"
        android:layout_marginTop="176dp"
        android:layout_marginEnd="20dp"
        android:background="#BBBBBB"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/orText_id"
        app:layout_constraintTop_toBottomOf="@+id/loginButton_id" />

    <TextView
        android:id="@+id/orText_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="165dp"
        android:layout_marginEnd="40dp"
        android:gravity="center"
        android:text="Or"
        android:textColor="#777777"
        android:textSize="14sp"
        app:layout_constraintEnd_toStartOf="@+id/rightLine_id"
        app:layout_constraintStart_toEndOf="@+id/leftLine_id"
        app:layout_constraintTop_toBottomOf="@+id/loginButton_id" />

    <TextView
        android:id="@+id/googleLogin_id"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="95dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:text="Google"
        android:textColor="#4285F4"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/orText_id"
        app:layout_constraintStart_toStartOf="@+id/orText_id"
        app:layout_constraintTop_toBottomOf="@+id/orText_id" />

    <TextView
        android:id="@+id/facebookLogin_id"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="100dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:text="Facebook"
        android:textColor="#04458A"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/leftLine_id"
        app:layout_constraintStart_toStartOf="@+id/leftLine_id"
        app:layout_constraintTop_toBottomOf="@+id/leftLine_id" />

    <TextView
        android:id="@+id/appleLogin_id"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="100dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:text="Apple"
        android:textColor="#333333"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/rightLine_id"
        app:layout_constraintStart_toStartOf="@+id/rightLine_id"
        app:layout_constraintTop_toBottomOf="@+id/rightLine_id" />
</androidx.constraintlayout.widget.ConstraintLayout>